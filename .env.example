# 阿里云百炼：聊天、向量与重排模型统一配置。
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=30

RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_API_KEY=
RERANKER_MODEL=qwen3-rerank
RERANKER_TIMEOUT_SECONDS=30

# PostgreSQL 保存结构化受理结果（表 intake_case_runs，由应用 CREATE TABLE IF NOT EXISTS 自建）。
# 用专用库 + 专用角色，不要用超级用户；留空则退回 data/intake.db，并在
# reflection.persistence.repository 里如实标成 sqlite（不伪装成已用 PG）。
INTAKE_DATABASE_URL=
# Redis 保存短期运行态，键形如 intake:run:<run_id>；留空则 redis_cached=false。
# 若服务端开了 ACL，用户名要与键前缀匹配（如 intake 用户只允许 ~intake:*）。
INTAKE_REDIS_URL=
INTAKE_REDIS_TTL_SECONDS=86400
INTAKE_REDIS_KEY_PREFIX=intake:run

# Elasticsearch：材料块全文检索与原文定位（与 Zilliz 语义召回双路 RRF 融合）。
# 留空时该路不参与，自动退回 Zilliz / 进程内关键词。
# 分词三级降级：ik_max_word（需插件）→ cjk_bigram（ES 自带，汉字二元组）→ standard（单字）。
# 自建 ES 若开启 HTTP TLS（官方 docker 镜像默认开启）用 https，自签证书需 ES_VERIFY_CERTS=false。
ES_URL=
ES_INDEX=intake_material_blocks
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_TIMEOUT_SECONDS=10
ES_VERIFY_CERTS=true

# Zilliz Cloud 保存全部材料切块向量和证据定位字段。
MILVUS_ENDPOINT=
MILVUS_TOKEN=
MILVUS_DB_NAME=
INTAKE_MILVUS_COLLECTION=intake_material_chunks

# OSS 保存原始材料和生成文书。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_INTAKE_PREFIX=intelligent-intake

# 字段组并行补抽的并发数（每组一次大模型调用）。
EXTRACTION_MAX_WORKERS=4

# MCP 业务工具：工单与供应商档案的外部系统地址。
# 留空时使用项目内置的脱敏样例，并在返回里标注 backend=local_sample。
INTAKE_ARCHIVE_API_BASE_URL=
INTAKE_ARCHIVE_API_TOKEN=
INTAKE_ARCHIVE_API_TIMEOUT_SECONDS=5

# 扫描件 OCR。后端可选 auto / bailian_vl / tesseract / off。
# auto：配了 VL key 就用百炼多模态，否则退回本机 Tesseract。
OCR_BACKEND=auto
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_KEY=
VL_MODEL=qwen-vl-ocr
VL_TIMEOUT_SECONDS=60
# 仅 tesseract 后端需要：本机 Tesseract 语言包
OCR_LANG=chi_sim+eng
